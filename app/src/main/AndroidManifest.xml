<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarmes no horário exato (lembretes, avisos de rotina, resumo diário).
         SCHEDULE_EXACT_ALARM é o padrão aceito pela Play Store sem declarar o app como
         alarme/calendário: no Android 12/13+ a permissão vem de um pedido em runtime
         (Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM), tratado na UI de Configurações.
         Antes NÃO declarávamos para 33+ e usávamos USE_EXACT_ALARM (concedida na instalação),
         que a Play Store só libera para apps de alarme/calendário; removida para evitar a
         exigência de política. Sem maxSdkVersion: declarada em todas as versões >= 23.
         Se revogada, reminder/ExactAlarms.kt degrada para alarme inexato em vez de crashar. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Atualizador in-app (botão manual em Configurações): consulta a GitHub Releases API e baixa
         o APK. INTERNET é usada SÓ aqui (o resto do app é offline). REQUEST_INSTALL_PACKAGES é
         exigida no Android 8+ para instalar o APK baixado; a confirmação final é do sistema. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".KalendrysApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kalendrys">

        <!-- singleTop: toques no widget e nas notificações chegam em onNewIntent se o app já estiver aberto. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- Ações "Concluir"/"Adiar" da notificação de lembrete + o toque do alarme de adiamento.
             exported=false: só recebe os PendingIntents que o próprio app cria. -->
        <receiver
            android:name=".reminder.ReminderActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.RoutineAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".summary.DailyReceiver"
            android:exported="false" />

        <!-- Callback do PackageInstaller (status da sessão de instalação do atualizador).
             exported=false: só recebe o PendingIntent que o próprio app cria. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.TasksWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_tasks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasks_info" />
        </receiver>

        <receiver
            android:name=".widget.SummaryWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_summary_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_summary_info" />
        </receiver>

        <receiver
            android:name=".widget.CalendarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>

    </application>

</manifest>
